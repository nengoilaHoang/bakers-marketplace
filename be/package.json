{
  "name": "be",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "npm run build && node dist/index.js",
    "dev": "tsx --watch src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:make": "knex --knexfile ./src/knexfile.ts migrate:make -x ts",
    "db:migrate": "knex --knexfile ./src/knexfile.ts migrate:latest",
    "db:rollback": "knex --knexfile ./src/knexfile.ts migrate:rollback",
    "db:list": "knex --knexfile ./src/knexfile.ts migrate:list",
    "db:seed:make": "knex --knexfile ./src/knexfile.ts seed:make -x ts",
    "db:seed": "knex --knexfile ./src/knexfile.ts seed:run"
  },
  "keywords": [],
  "type": "module",
  "imports": {
    "#/*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "morgan": "^1.12.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.5.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
